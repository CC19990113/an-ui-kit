{
  "name": "an-ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:custom": "node scripts/build-elements.mjs --mode custom",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "cem": "x-cem scan --src packages/elements/src --out custom-elements-manifest.json",
    "registry": "pnpm cem && node scripts/gen-registry.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "new:component": "node scripts/new-component.mjs"
  },
  "devDependencies": {
    "x-cem": "^0.1.2"
  }
}
