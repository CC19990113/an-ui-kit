{
  "name": "@an-ui-kit/elements",
  "version": "0.1.0",
  "description": "Framework-agnostic web components with zero runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": "./react.d.ts",
    "./vue": "./vue.d.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "react.d.ts",
    "vue.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/an-ui-kit.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/CC19990113/an-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/CC19990113/an-ui-kit/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "ui-kit",
    "react",
    "vue"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node ../../scripts/build-elements.mjs --mode all && tsc -p tsconfig.build.json",
    "build:custom": "node ../../scripts/build-elements.mjs --mode custom",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config test/vitest.config.ts",
    "test:coverage": "vitest run --config test/vitest.config.ts --coverage",
    "test:watch": "vitest --config test/vitest.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
